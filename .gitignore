# ==========================================
# Unified AI Workspace - Git Ignore Rules
# ==========================================

# 1. Environment Configurations & Secrets
.env
.env.local
.env.development
.env.test
.env.production
.env.*
!.env.example
*.pem
*.key
*.cert

# 2. Dependencies
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 3. Storage, Uploads & Local User Data
storage/
storage/**
backend/storage/
backend/storage/**
backend/storage/drive/
backend/storage/gmail/
backend/storage/reports/
backend/storage/temporary/
backend/storage/whatsapp/
uploads/
temp/
temporary/

# 4. WhatsApp & Baileys Session Stores
auth_info_baileys/
session/
sessions/
*.session
baileys_auth_info/

# 5. OAuth & Service Tokens
credentials.json
token.json
google_tokens.json
oauth_tokens/

# 6. Database Dumps & Local Databases
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.backup
# Allow version-controlled schema migrations
!backend/src/database/migrations/*.sql

# 7. Build Outputs
dist/
build/
out/
.vite/
frontend/dist/
frontend/.vite/

# 8. Logs & Diagnostic Traces
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
backend/logs/

# 9. OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 10. IDE & Editor Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 11. Test & Coverage Outputs
coverage/
.nyc_output/
