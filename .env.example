# ==============================================================================
# UNIFIED AI WORKSPACE - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` before starting the server.
# Fill in your own database credentials, API keys, and OAuth secrets.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION KEYS
# ------------------------------------------------------------------------------
# A secure 32+ character random string used to sign session JWTs
JWT_SECRET=change_me_to_a_random_32_character_jwt_secret_key!

# MUST be an exact 32-character string used for AES-256-GCM encryption
# of OAuth access/refresh tokens and third-party AI provider keys in MySQL.
CREDENTIAL_ENCRYPTION_KEY=change_me_to_exact_32_byte_key!

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL 8.0 / 8.4 LTS)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=unified_ai_workspace

# ------------------------------------------------------------------------------
# 4. PRIMARY AI PROVIDER: GOOGLE GEMINI
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 5. OPTIONAL MULTI-PROVIDER AI CONFIGURATION
# ------------------------------------------------------------------------------
# You can also configure these dynamically in Application Settings UI.
# OpenAI API Key (starts with sk-proj- or sk-): https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic Claude API Key (starts with sk-ant-): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 (GMAIL & GOOGLE DRIVE INTEGRATION)
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI must match: http://localhost:5000/api/connections/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/connections/google/callback

# ------------------------------------------------------------------------------
# 7. LOCAL STORAGE PATH
# ------------------------------------------------------------------------------
# Root folder for cached drive files, email attachments, and generated reports.
# Defaults relative to backend root: ../../storage
STORAGE_PATH=../../storage

# ------------------------------------------------------------------------------
# 8. WHATSAPP ARCHIVE & API SERVICE (OPTIONAL EXTERNAL CONNECTOR)
# ------------------------------------------------------------------------------
# Base URL for the WhatsApp microservice / MCP bridge (default: port 3001)
WHATSAPP_API_BASE_URL=http://localhost:3001
WHATSAPP_API_KEY=
WHATSAPP_API_TIMEOUT_MS=8000
WHATSAPP_POLL_INTERVAL_MS=5000
